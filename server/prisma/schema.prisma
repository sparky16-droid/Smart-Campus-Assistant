generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Building {
  id                   String     @id @default(uuid())
  name                 String
  code                 String     @unique
  description          String
  latitude             Float
  longitude            Float
  floors               Int        @default(1)
  yearBuilt            Int?
  wheelchairAccessible Boolean    @default(true)
  facilities           Facility[]
  departments          Department[]
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
}

model Facility {
  id             String    @id @default(uuid())
  name           String
  category       String    // Academic, Library, Cafeteria, Sports, Lab, Hostel, Administration, Medical, Transport, ATM, Service
  description    String
  buildingId     String?
  building       Building? @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  floor          String?
  roomNumber     String?
  landmark       String?
  timings        String?
  contactPhone   String?
  contactEmail   String?
  isOperational  Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Department {
  id               String    @id @default(uuid())
  name             String
  code             String    @unique
  description      String
  buildingId       String?
  building         Building? @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  headOfDepartment String
  contactEmail     String
  contactPhone     String?
  websiteUrl       String?
  programsOffered  String    // Comma separated or JSON string
  faculty          Faculty[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Faculty {
  id             String      @id @default(uuid())
  name           String
  title          String      @default("Prof.") // Dr., Prof., Mr., Ms.
  designation    String      // Professor, Associate Professor, Assistant Professor, HOD
  departmentId   String?
  department     Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  email          String
  phone          String?
  cabinRoom      String?
  officeHours    String?
  specialization String?
  bio            String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model Notice {
  id          String    @id @default(uuid())
  title       String
  content     String
  category    String    // Academic, Event, Exam, Placement, General
  priority    String    @default("Normal") // Low, Normal, High, Urgent
  publishDate DateTime  @default(now())
  expiryDate  DateTime?
  isPublished Boolean   @default(true)
  author      String    @default("Administration")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Faq {
  id        String   @id @default(uuid())
  question  String
  answer    String
  category  String   // Admissions, Academics, Facilities, Transport, Hostel, General
  keywords  String   // Comma-separated search keywords
  viewCount Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Synonym {
  id          String   @id @default(uuid())
  primaryWord String   @unique
  synonyms    String   // Comma separated synonyms: e.g. "books,reading room,central library"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ChatMessage {
  id               String   @id @default(uuid())
  sessionId        String
  role             String   // user, assistant
  content          String
  helpful          Boolean? // true = helpful, false = not helpful, null = no feedback
  feedbackText     String?
  referencedEntity String?  // JSON string containing relevant links/locations
  createdAt        DateTime @default(now())
}

model CampusSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model AdminUser {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  fullName     String
  role         String   @default("admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
