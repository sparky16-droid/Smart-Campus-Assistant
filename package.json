{
  "name": "smart-campus-assistant",
  "version": "1.0.0",
  "description": "Smart Campus Assistant - AI-Assisted Campus Information and Navigation Platform",
  "private": true,
  "scripts": {
    "build": "cd client && npm run build",
    "install:all": "npm run install:server && npm run install:client",
    "install:server": "cd server && npm install",
    "install:client": "cd client && npm install",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "test": "cd server && npm run test",
    "seed": "cd server && npm run seed"
  },
  "keywords": ["smart-campus", "chatbot", "react", "express", "leaflet", "prisma", "sqlite"],
